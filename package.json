{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:e2e": "node scripts/run-with-env.mjs VITE_E2E_MODE=true -- npm run build",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "lint": "tsc --noEmit",
    "test": "tsx scripts/verify_english_curriculum.ts",
    "test:audit": "tsx scripts/deep_architecture_audit.ts",
    "test:security": "tsx scripts/verify_security_hardening.ts",
    "test:e2e": "playwright test",
    "test:acceptance": "npm run lint && npm run test && npm run test:audit && npm run test:security && npm run test:hierarchy && npm run test:source-alignment && npm run build && npm run test:e2e",
    "admin:bootstrap": "tsx scripts/bootstrap_admin.ts",
    "test:hierarchy": "tsx scripts/verify_curriculum_hierarchy.ts",
    "test:source-alignment": "tsx scripts/verify_source_content_alignment.ts",
    "test:rules": "tsx scripts/verify_firebase_rules.ts"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7",
    "body-parser": "1.20.9",
    "glob": "14.0.5",
    "minimatch": "11.0.8",
    "qs": "6.17.1",
    "re2js": "2.8.7",
    "rimraf": "6.1.4",
    "source-map-js": "1.2.2"
  }
}
