rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Default deny catch-all
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // STRICT CUSTOM CLAIMS ONLY: No fallback to token.role or documents
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isTeacher() {
      return isAuthenticated() && request.auth.token.teacher == true;
    }

    function isTeacherOrAdmin() {
      return isAdmin() || isTeacher();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Curriculum original PDFs and source files
    // Write: authorized administrators and teachers only (max 25MB, PDF MIME type)
    // Read: strictly administrators and authorized teachers only (students cannot read/download private original PDFs)
    match /curriculum_sources/{sourceId}/{fileName} {
      allow read: if isTeacherOrAdmin();
      allow write: if isTeacherOrAdmin() &&
                     request.resource.size <= 25 * 1024 * 1024 &&
                     (request.resource.contentType == 'application/pdf' || request.resource.contentType == 'application/octet-stream');
    }

    // Curriculum drafts under review (restricted to teachers and admins)
    match /curriculum_drafts/{draftId}/{fileName} {
      allow read, write: if isTeacherOrAdmin() &&
                            request.resource.size <= 25 * 1024 * 1024;
    }

    // Explicitly published educational derivatives (e.g. summaries, public excerpts approved for students)
    match /curriculum_public/{gradeId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() && request.resource.size <= 10 * 1024 * 1024;
    }

    // Student private user assets (e.g. avatars, user study notes attachments)
    match /students/{studentId}/{fileName} {
      allow read: if isOwner(studentId) || isTeacherOrAdmin();
      allow write: if isOwner(studentId) &&
                     request.resource.size <= 5 * 1024 * 1024 &&
                     request.resource.contentType.matches('image/.*');
    }
  }
}

