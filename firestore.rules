rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny catch-all to prevent unmapped collection access
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Hardened path and ID validator
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check student document ownership
    function isOwner(studentId) {
      return isAuthenticated() && isValidId(studentId) && (request.auth.uid == studentId);
    }

    // Trusted Admin/Teacher Check via explicit admin document existence or verified claims
    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        (request.auth.token.email_verified == true && request.auth.token.email in ['alnukhbazubair@gmail.com', 'admin@almaliki.edu.iq'])
      );
    }

    function isTeacherOrAdmin() {
      return isAuthenticated() && (
        isAdmin() ||
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) ||
        request.auth.token.role == 'teacher'
      );
    }

    // Student profile field-level validator for create & update
    function isValidStudent(data) {
      return data.uid is string && data.uid == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (!('email' in data) || data.email is string) &&
             (!('xp' in data) || (data.xp is number && data.xp >= 0 && data.xp <= 1000000)) &&
             (!('selectedGrade' in data) || (data.selectedGrade in ['third-intermediate', 'fourth-preparatory', 'fifth-preparatory', 'sixth-preparatory'])) &&
             (!('completedLessonIds' in data) || (data.completedLessonIds is list && data.completedLessonIds.size() <= 500)) &&
             (!('bookmarkedQuestionIds' in data) || (data.bookmarkedQuestionIds is list && data.bookmarkedQuestionIds.size() <= 500)) &&
             (!('totalQuestionsAttempted' in data) || (data.totalQuestionsAttempted is number && data.totalQuestionsAttempted >= 0)) &&
             (!('totalQuestionsCorrect' in data) || (data.totalQuestionsCorrect is number && data.totalQuestionsCorrect >= 0)) &&
             (!('streakDays' in data) || (data.streakDays is number && data.streakDays >= 0 && data.streakDays <= 3650)) &&
             (!('unlockedBadges' in data) || (data.unlockedBadges is list && data.unlockedBadges.size() <= 100)) &&
             (!('role' in data) || isAdmin()) &&
             (!('isAdmin' in data) || isAdmin()) &&
             (!('verificationStatus' in data) || isAdmin());
    }

    // Student profile, settings and overall progress (strict owner-only privacy & validation)
    match /students/{studentId} {
      allow read: if isOwner(studentId) || isAdmin();
      allow create: if isOwner(studentId) && isValidStudent(request.resource.data);
      allow update: if isOwner(studentId) && isValidStudent(request.resource.data) &&
                      request.resource.data.uid == resource.data.uid &&
                      // Prevent unauthorized client manipulation of administrative fields
                      (!('role' in request.resource.data) || ('role' in resource.data && request.resource.data.role == resource.data.role)) &&
                      (!('isAdmin' in request.resource.data) || ('isAdmin' in resource.data && request.resource.data.isAdmin == resource.data.isAdmin));
      allow delete: if isAdmin();

      // Student sub-collections: exam results
      match /exam_results/{resultId} {
        allow read: if isOwner(studentId) || isAdmin();
        allow create, update: if isOwner(studentId) && isValidId(resultId) &&
                                request.resource.data.score is number &&
                                request.resource.data.percentage is number &&
                                request.resource.data.percentage >= 0 &&
                                request.resource.data.percentage <= 100;
        allow delete: if isAdmin();
      }

      // Student sub-collections: notes
      match /notes/{noteId} {
        allow read: if isOwner(studentId);
        allow create, update, delete: if isOwner(studentId) && isValidId(noteId);
      }

      // Student sub-collections: bookmarks
      match /bookmarks/{bookmarkId} {
        allow read: if isOwner(studentId);
        allow create, update, delete: if isOwner(studentId) && isValidId(bookmarkId);
      }
    }

    // Admin directory (admin write only)
    match /admins/{adminId} {
      allow read: if isAuthenticated() && isValidId(adminId);
      allow write: if isAdmin() && isValidId(adminId);
    }

    // Teacher directory (admin write only)
    match /teachers/{teacherId} {
      allow read: if isAuthenticated() && isValidId(teacherId);
      allow write: if isAdmin() && isValidId(teacherId);
    }

    // Global leaderboards / public statistics (read-only for clients, writes secured)
    match /leaderboard/{entry} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Shared curriculum or malzama drafts (read-only for clients, writes secured)
    match /curriculum_shared/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Published official curriculum sources (public read for students, supervisor/admin-only write)
    match /curriculum_sources/{sourceId} {
      allow read: if isValidId(sourceId);
      allow write: if isTeacherOrAdmin() && isValidId(sourceId);
    }

    // Curriculum drafts under supervisor review (strictly restricted to authorized teachers & admins)
    match /curriculum_drafts/{draftId} {
      allow read, write: if isTeacherOrAdmin() && isValidId(draftId);
    }
  }
}
